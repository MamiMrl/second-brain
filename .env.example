# MongoDB Atlas
MONGODB_ATLAS_URI=
MONGODB_DB_NAME=second_brain

# Claude (generation) — https://console.anthropic.com/
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Voyage AI (embeddings) — https://dash.voyageai.com/
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5

# LangSmith (observability) — https://smith.langchain.com/
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=second-brain
LANGSMITH_TRACING=true

# Query-time filter inference (PRD FR-2.2) — default: local Ollama, swappable to Haiku/others
FILTER_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434
